# Converza settings. Copy to .env for local runs; production uses /srv/converza/.env (chmod 600).

# --- required ---
JWT_SECRET=                      # openssl rand -hex 32 (the app refuses to start without it)
POSTGRES_PASSWORD=app            # prod: openssl rand -hex 16 (compose interpolates it into DATABASE_URL)
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5462/app   # local dev only; compose.prod.yml sets it

# --- users ---
SEED_ADMIN_EMAIL=                # first admin, created only when no admin exists
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=             # owner@converza.uz (Farovon Savdo MChJ) — created only when absent
SEED_OFFICER_PASSWORD=           # officer@converza.uz (G. Abdullayeva) — created only when absent
DEMO_LOGIN_ENABLED=false         # passwordless POST /api/v1/auth/demo; 404 when false (production: false)
SEED_DEMO=false                  # app.seed_demo pushes the demo bundles through the pipeline

# --- worker / job queue ---
WORKER_ENABLED=true              # in-process worker in the API (dev). Prod: false + `python -m app.worker`
WORKER_CONCURRENCY=2
WORKER_POLL_S=0.5
WORKER_STALE_LOCK_S=300

# --- public /analyse path ---
PUBLIC_DEADLINE_S=55             # partial result after this; always answers in < 60 s
PUBLIC_RETENTION_HOURS=24        # public uploads are purged after this
PUBLIC_MAX_UPLOAD_MB=20
PUBLIC_MAX_OCR_PAGES=10

# --- storage ---
FILES_DIR=./data/files           # prod: /data/files (docker volume)
EVAL_RESULTS_DIR=./eval/results  # newest *.json is served at /api/v1/metrics/eval

# --- LLM (narrative, CFO Q&A, unmapped-line fallback only) ---
LLM_PROVIDER=openai              # openai | anthropic | ollama | none
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=                    # ollama: http://ollama:11434/v1
LLM_TIMEOUT_S=20
LLM_REDACT=true                  # borrower name/STIR never sent to the provider
OPENAI_API_KEY=                  # empty => template narrative, nothing crashes
ANTHROPIC_API_KEY=

CORS_ORIGINS=["https://converza.uz","https://app.converza.uz"]   # owner app + bank app (add http://localhost:5173 for dev)

# --- build metadata (set by deploy) ---
GIT_SHA=dev
BUILT_AT=
DEPLOYED_AT=
